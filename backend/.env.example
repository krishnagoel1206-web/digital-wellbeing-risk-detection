# Example environment file. Copy to .env and edit as needed.
# All values have working defaults, so .env is optional.

# API_NAME=Digital Wellbeing Risk API
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Minimum days of history before a personal baseline is considered reliable.
MIN_DAYS_FOR_BASELINE=14

# Late-night window used for the late-night usage ratio (24h clock).
LATE_NIGHT_START_HOUR=23
LATE_NIGHT_END_HOUR=6
